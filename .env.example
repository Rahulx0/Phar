# Copy to .env and adjust. NEVER commit the real .env (it is gitignored).
# These values are read by docker-compose.yml.

# PostgreSQL credentials (must match a strong value in real deployments)
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=change-me-to-something-strong
POSTGRES_DB=pharmacy

# Which image the app service runs. This is also the rollback lever:
#   deploy new version: IMAGE_TAG=sha-abc1234 docker compose up -d app
#   rollback:           IMAGE_TAG=sha-oldone docker compose up -d app
# To run an image published by CI from GHCR, also set IMAGE_NAME, e.g.
#   IMAGE_NAME=ghcr.io/<your-user>/pharmacy-platform
IMAGE_NAME=pharmacy-api
IMAGE_TAG=local

# Application logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Host ports for nginx — override if 80/443 are taken on your machine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
